# Base URL of the real FastAPI backend (it exposes a single POST /chat endpoint).
# Leave commented out to use the built-in offline demo engine (lib/engine.ts).
# Local backend:   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Deployed (Render): NEXT_PUBLIC_API_URL=https://<your-service>.onrender.com
# Android emulator: use http://10.0.2.2:8000 instead of 127.0.0.1
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
